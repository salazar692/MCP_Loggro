# Plantilla de configuración de MCP_Loggro.
#
# - Copia este archivo como `.env` SOLO para desarrollo local (`.env` está en .gitignore)
#   y úsalo con: node --env-file=.env dist/index.js
# - Nunca subas credenciales reales al repositorio ni las pegues en issues, PRs o chats.
# - Con un cliente MCP (p. ej. Claude Desktop), define estas variables en el bloque
#   `env` de su configuración en lugar de usar `.env`.
# - Si puedes, usa un usuario de Restobar dedicado al MCP, con permisos mínimos
#   (ver docs/security.md).

# --- Restobar (Loggro): usa UNA de las dos opciones ------------------------
# Opción 1: token ya obtenido (el `tokenCurrent` de POST /login). No se guarda ninguna
# contraseña; cuando Restobar lo rechace, hay que reemplazarlo (su JWT no trae `exp`).
LOGGRO_RESTOBAR_TOKEN=

# Opción 2: usuario y contraseña. El servidor obtiene el token con POST /login y lo
# renueva solo si Restobar lo rechaza.
LOGGRO_RESTOBAR_EMAIL=
LOGGRO_RESTOBAR_PASSWORD=

# URL base documentada oficialmente. Solo se acepta https://.
LOGGRO_RESTOBAR_BASE_URL=https://api.pirpos.com

# --- Datos ------------------------------------------------------------------
# true = ocultar documento, correo, teléfono, dirección y fecha de nacimiento
# de clientes en las respuestas al modelo.
LOGGRO_REDACT_PERSONAL_DATA=false

# Zona horaria IANA para interpretar las fechas YYYY-MM-DD.
LOGGRO_TIMEZONE=America/Bogota

# Carpeta (ruta absoluta; admite ~) donde se guardan las exportaciones a Excel.
# Vacío = ~/Downloads/MCP-Loggro. Los archivos nunca se sobrescriben.
LOGGRO_EXPORT_DIR=

# --- General -------------------------------------------------------------------
# Nivel de log (siempre a stderr): debug | info | warn | error
LOG_LEVEL=info
